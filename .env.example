# Copy to .env (never commit .env). Values come from `supabase status` locally or the dashboard.

# Safe to ship inside the Flutter / web app (public, protected by RLS):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# SERVER ONLY. Edge Functions receive these automatically; never put them in Flutter, web
# bundles, Git history, chat messages or screenshots:
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secret (set with: supabase secrets set STUDENT_EMAIL_DOMAIN=...).
# Internal login-email domain for students. Must never receive real mail.
STUDENT_EMAIL_DOMAIN=students.myschool.local
